<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 240" width="100%" height="100%">
  <defs>
    <linearGradient id="bloomBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#24101e"/>
      <stop offset="100%" stop-color="#3b1231"/>
    </linearGradient>
    <linearGradient id="bloomGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e"/>
      <stop offset="50%" stop-color="#e11d48"/>
      <stop offset="100%" stop-color="#be123c"/>
    </linearGradient>
  </defs>
  <rect width="400" height="240" rx="20" fill="url(#bloomBg)"/>
  <!-- Bloom Beauty Lotus / Blossom Motif -->
  <g transform="translate(200,85)">
    <circle cx="0" cy="0" r="40" fill="none" stroke="url(#bloomGrad)" stroke-width="1.5" opacity="0.3"/>
    <path d="M0,18 C-20,6 -26,-15 0,-26 C26,-15 20,6 0,18 Z" fill="url(#bloomGrad)"/>
    <path d="M0,18 C-14,0 -20,-8 -12,-22 C-2,-14 0,0 0,18 Z" fill="#fda4af" opacity="0.6"/>
    <path d="M0,18 C14,0 20,-8 12,-22 C2,-14 0,0 0,18 Z" fill="#fda4af" opacity="0.6"/>
  </g>
  <!-- Typography -->
  <text x="200" y="160" font-family="'Poppins', 'Segoe UI', sans-serif" font-size="24" font-weight="800" fill="#ffffff" letter-spacing="4" text-anchor="middle">BLOOM BEAUTY</text>
  <text x="200" y="186" font-family="'Poppins', 'Segoe UI', sans-serif" font-size="11" font-weight="600" fill="#f43f5e" letter-spacing="3" text-anchor="middle">PURE &amp; CRUELTY-FREE</text>
  <line x1="130" y1="202" x2="270" y2="202" stroke="#f43f5e" stroke-width="1" stroke-opacity="0.4"/>
</svg>