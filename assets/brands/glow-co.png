<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 240" width="100%" height="100%">
  <defs>
    <linearGradient id="glowBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a1620"/>
      <stop offset="100%" stop-color="#1f1118"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffd1dc"/>
      <stop offset="50%" stop-color="#f472b6"/>
      <stop offset="100%" stop-color="#db2777"/>
    </linearGradient>
  </defs>
  <rect width="400" height="240" rx="20" fill="url(#glowBg)"/>
  <!-- Botanical Droplet Glow Motif -->
  <circle cx="200" cy="85" r="44" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" opacity="0.4"/>
  <path d="M200,50 C200,50 178,82 178,96 A22,22 0 0,0 222,96 C222,82 200,50 200,50 Z" fill="url(#goldGrad)" opacity="0.9"/>
  <circle cx="200" cy="96" r="6" fill="#ffffff" opacity="0.8"/>
  <!-- Typography -->
  <text x="200" y="160" font-family="'Poppins', 'Segoe UI', sans-serif" font-size="25" font-weight="800" fill="#ffffff" letter-spacing="3.5" text-anchor="middle">GLOW &amp; CO.</text>
  <text x="200" y="186" font-family="'Poppins', 'Segoe UI', sans-serif" font-size="11" font-weight="600" fill="#f472b6" letter-spacing="3" text-anchor="middle">DERMA BOTANICAL SKINCARE</text>
  <line x1="140" y1="202" x2="260" y2="202" stroke="#f472b6" stroke-width="1" stroke-opacity="0.4"/>
</svg>